<Project>

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- XML docs ship with the package, but not every member is documented yet. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup Label="Package metadata">
        <Authors>Wesley Twyman</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Katuva/Jmap.Net</RepositoryUrl>
        <PackageProjectUrl>https://github.com/Katuva/Jmap.Net</PackageProjectUrl>
        <Version>0.1.0</Version>
        <PackageTags>jmap;email;mail;rfc8620;rfc8621;rfc8887;rfc9007;rfc9219;rfc9404;rfc9425</PackageTags>
    </PropertyGroup>

</Project>
